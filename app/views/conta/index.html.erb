<main class="bg-gradient-to-r from-black to-primary min-h-screen">
  <div class="flex flex-cols justify-center items-center min-h-screen">
    <div class="border-4 rounded-xl p-10 bg-white/10 backdrop-blur-sm h-[400px] w-[250px]">
      <p style="color: green"><%= notice %></p>
      
      <% content_for :title, "Contas" %>
      
      <h1>Conta</h1>
      
      <div id="conta">
      
      
        <%@contas.each do |contum| %>
          <%= render contum %>
          <p>
            <%= link_to "Show this contum", contum %>
          </p>
      
      
        <% end %>
      </div>
      
      <%= link_to "New contum", new_contum_path %>
    </div>
  </div>
</main>
