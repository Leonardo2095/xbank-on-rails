  <% if contum.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(contum.errors.count, "error") %> prohibited this contum from being saved:</h2>

      <ul>
        <% contum.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_for (@contum) do |form|%>
    <div class="mb-6">
      <%= form.label :password %>
      <% if @minimum_password_length %>
      <em>(<%= @minimum_password_length %> characters minimum)</em>
      <% end %><br />
      <%= form.password_field :password, class: "w-60 border-2 rounded-md hover:scale-105 transition duration-300 ease-in-out " %>
    </div>  

    <div class="mb-6">
      <%= form.label :nome %><br />
      <%= form.text_field :nome, class: "w-60 border-2 rounded-md hover:scale-105 transition duration-300 ease-in-out " %>
    </div>

    <div>
      <%= form.submit %>
    </div>
  <%end%>

