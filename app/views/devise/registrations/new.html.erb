<main class="text-white bg-gradient-to-r from-black to-primary">
  <!-- Div para centralizar-->
  <div class="flex flex-col justify-center items-center min-h-screen">
    <!--Div da "caixa" do formulario-->
    <div class="border-4 rounded-xl p-10 bg-white/10 backdrop-blur-sm">
      <h2 class="mb-10 flex justify-center font-bold">Cadastro</h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="mb-6 ">
          <%= f.label :email %><br />
          <%= f.email_field :email, autofocus: true, autocomplete: "email" , class: "w-60 border-2 rounded-md hover:scale-105 transition duration-300 ease-in-out " %>
        </div>

        <div class="mb-6 ">
          <%= f.label :name %><br />
          <%= f.text_field :nome, autofocus: true, autocomplete: "nome" , class: "w-60 border-2 rounded-md hover:scale-105 transition duration-300 ease-in-out " %>
        </div>

        <div class="mb-6 ">
          <%= f.label :cpf %><br />
          <%= f.text_field :cpf, autofocus: true, autocomplete: "cpf" , class: "w-60 border-2 rounded-md hover:scale-105 transition duration-300 ease-in-out " %>
        </div>


        <div class="mb-6">
          <%= f.label :password %>
          <% if @minimum_password_length %>
          <em>(<%= @minimum_password_length %> characters minimum)</em>
          <% end %><br />
          <%= f.password_field :password, autocomplete: "new-password" , class: "w-60 border-2 rounded-md hover:scale-105 transition duration-300 ease-in-out " %>
        </div>

        <div class="mb-6">
          <%= f.label :password_confirmation %><br />
          <%= f.password_field :password_confirmation, autocomplete: "new-password" , class: "w-60 border-2 rounded-md hover:scale-105 transition duration-300 ease-in-out " %>
        </div>

        <div class="flex justify-center">
          <%= f.submit "Sign up", class:"btn pl-5 pr-5 bg-primary hover:scale-105 hover:bg-black trasition duration-600 ease-in-out" %>
        </div>
      <% end %>

      <%=  render "devise/shared/links"%>
      
    </div>
  </div>
</main>
